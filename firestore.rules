rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basic types
    function isString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }
    function isNumber(val) {
      return val is number;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if true; // Demo mode admin access
    }

    match /orders/{orderId} {
      allow create: if true; // Anyone can checkout
      allow read, update, delete: if true; // Demo mode admin access
    }
  }
}
